# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=richtalk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=richtalk

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=changeme

# API
API_PORT=8080
JWT_SECRET=changeme_use_long_random_string_at_least_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Migrations (relative to binary CWD, or absolute path)
# In prod container: /migrations (set by Dockerfile ENV)
# In dev container: migrations (relative to /app, set by default)
MIGRATIONS_PATH=migrations

# App
APP_ENV=development
