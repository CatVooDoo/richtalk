FROM golang:1.23-alpine

RUN go install github.com/air-verse/air@v1.61.1

WORKDIR /app

COPY go.mod go.sum* ./
ENV GOFLAGS="-mod=mod"
RUN go mod download

# Source and migrations are bind-mounted at runtime via docker-compose.dev.yml
# MIGRATIONS_PATH defaults to "migrations" (relative to WORKDIR /app)

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
